# Docker Compose 部署配置（复制为 .env 后按需修改）
HEPHAESTUS_PORT=18181
HEPHAESTUS_VERSION=dev

# 叠加 docker-compose.ghcr.yml 时使用的镜像；留空为官方 latest。
# HEPHAESTUS_IMAGE=ghcr.io/qiwentaidi/hephaestus:latest

# 数据库：postgres（默认内置）或 sqlite
HEPHAESTUS_DB_TYPE=postgres
# local / 127.0.0.1 表示使用镜像内置 PostgreSQL；外部地址则连接外部数据库
HEPHAESTUS_DB_HOST=local
HEPHAESTUS_DB_PORT=5432
HEPHAESTUS_DB_USER=postgres
HEPHAESTUS_DB_NAME=hephaestus
HEPHAESTUS_DB_SSLMODE=disable
HEPHAESTUS_EMBEDDED_POSTGRES=1

# 内置 PostgreSQL 留空时自动生成密码；使用外部 PostgreSQL 时按实际配置填写。
HEPHAESTUS_DB_PASSWORD=
# 留空表示首次启动自动生成并持久化到数据卷；设置后以该值为准。
HEPHAESTUS_JWT_SECRET=
